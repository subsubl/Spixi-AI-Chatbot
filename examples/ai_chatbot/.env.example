# Environment variables for examples/ai_chatbot
# Copy this file to `.env` or export variables in your environment before running the bot.

# QuIXI HTTP API endpoint (include http://)
QUIXI_API=http://localhost:8001

# Local LLM (LM Studio or compatible) base URL (OpenAI-compatible)
LM_STUDIO_API=http://localhost:1234/v1

# MQTT broker settings
MQTT_BROKER=localhost
MQTT_PORT=1883

# Network timeouts (seconds)
REQUEST_TIMEOUT=10

# Logging
LOG_LEVEL=INFO

# Local model settings
LM_API_KEY=not-needed
LM_MODEL=local-model
LM_TEMPERATURE=0.7
LM_MAX_TOKENS=500

# Behavior toggles
# If true, the bot will auto-accept incoming contact requests. Set to 'false' to require manual acceptance.
AUTO_ACCEPT_CONTACTS=true
